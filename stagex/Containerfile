FROM stagex/pallet-clang-cmake-busybox AS build
COPY --from=stagex/core-git . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-m4 . /
COPY --from=stagex/core-bison . /
COPY --from=stagex/core-flex . /
COPY --from=stagex/core-readline . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/user-libevent . /
COPY --from=stagex/user-libsodium . /
COPY --from=stagex/user-zeromq . /
COPY --from=stagex/user-patch . /
ARG TARGETARCH
ARG BOOST_VERSION_UNDER
ARG MONERO_C_VERSION
ARG SALVIUM_VERSION
ARG MINIUPNP_VERSION
ARG MX25519_VERSION
ARG RAPIDJSON_VERSION
ARG SUPERCOP_VERSION
ARG RANDOMX_VERSION
ARG BC_UR_VERSION
ARG POLYSEED_VERSION
ARG UTF8PROC_VERSION
ARG UNBOUND_VERSION
ARG PATCHUTILS_VERSION
ADD fetch/boost_${BOOST_VERSION_UNDER}.tar.bz2 /
ADD fetch/monero_c-${MONERO_C_VERSION}.tar.gz /
ADD fetch/salvium-${SALVIUM_VERSION}.tar.gz /
ADD fetch/miniupnp-${MINIUPNP_VERSION}.tar.gz /
ADD fetch/mx25519-${MX25519_VERSION}.tar.gz /
ADD fetch/rapidjson-${RAPIDJSON_VERSION}.tar.gz /
ADD fetch/supercop-${SUPERCOP_VERSION}.tar.gz /
ADD fetch/randomx-${RANDOMX_VERSION}.tar.gz /
ADD fetch/bc-ur-${BC_UR_VERSION}.tar.gz /
ADD fetch/polyseed-${POLYSEED_VERSION}.tar.gz /
ADD fetch/utf8proc-${UTF8PROC_VERSION}.tar.gz /
ADD fetch/unbound-${UNBOUND_VERSION}.tar.gz /
ADD fetch/patchutils-${PATCHUTILS_VERSION}.tar.xz /
COPY patches/fix-av.patch /tmp/fix-av.patch
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	set -eu
	export CFLAGS="-O2 -g0 -ffile-prefix-map=/work=. -fdebug-prefix-map=/work=."
	export CXXFLAGS="$CFLAGS"
	export LDFLAGS="$LDFLAGS -Wl,--build-id=none"

	cd "/boost_${BOOST_VERSION_UNDER}"
	./bootstrap.sh \
		--with-toolset=clang \
		--with-libraries=filesystem,thread,date_time,chrono,serialization,program_options,locale,system,regex
	./b2 \
		-j"$(nproc)" \
		--prefix=/usr \
		--layout=system \
		toolset=clang \
		variant=release \
		threading=multi \
		debug-symbols=off \
		runtime-link=shared \
		link=static \
		boost.locale.icu=off \
		install

	cd "/patchutils-${PATCHUTILS_VERSION}"
	./configure --prefix=/usr
	make
	make install

	cd "/unbound-release-${UNBOUND_VERSION}"
	./configure \
		--prefix=/usr \
		--disable-flto \
		--disable-rpath \
		--without-pyunbound \
		--without-pythonmodule \
		--with-libevent \
		--with-libexpat=/usr \
		--with-ssl=/usr
	make
	make install

	mv "/monero_c-${MONERO_C_VERSION}" /work
	cd /work
	rm -rf salvium
	mv "/salvium-${SALVIUM_VERSION}" salvium
	git -C salvium init -q
	for patch_file in patches/salvium/*.patch; do
		filtered_patch="$(mktemp)"
		if [ "$(basename "$patch_file")" = "0017-serialize-cache-to-JSON.patch" ]; then
			filterdiff \
				-x '*/.gitmodules' \
				-x '*/external/randomx' \
				-x '*/external/bc-ur' \
				-x '*/external/polyseed' \
				-x '*/external/utf8proc' \
				-x '*/src/wallet/api/wallet2_api.h' \
				"$patch_file" > "$filtered_patch"
		else
			filterdiff \
				-x '*/.gitmodules' \
				-x '*/external/randomx' \
				-x '*/external/bc-ur' \
				-x '*/external/polyseed' \
				-x '*/external/utf8proc' \
				"$patch_file" > "$filtered_patch"
		fi
		if grep -q '^--- ' "$filtered_patch"; then
			patch -d salvium -p1 --batch --fuzz=3 < "$filtered_patch"
		fi
		rm "$filtered_patch"
	done
	sed -i \
		's|    //! get yield information|    //! serialize wallet cache to JSON\n    virtual std::string serializeCacheToJson() const = 0;\n\n    //! get yield information|' \
		salvium/src/wallet/api/wallet2_api.h

	rm -rf salvium/external/miniupnp salvium/external/mx25519 \
		salvium/external/rapidjson salvium/external/supercop \
		salvium/external/randomx salvium/external/bc-ur \
		salvium/external/polyseed salvium/external/utf8proc
	mv "/miniupnp-${MINIUPNP_VERSION}" salvium/external/miniupnp
	mv "/mx25519-${MX25519_VERSION}" salvium/external/mx25519
	mv "/rapidjson-${RAPIDJSON_VERSION}" salvium/external/rapidjson
	mv "/supercop-${SUPERCOP_VERSION}" salvium/external/supercop
	mv "/RandomX-${RANDOMX_VERSION}" salvium/external/randomx
	mv "/bc-ur-${BC_UR_VERSION}" salvium/external/bc-ur
	mv "/polyseed-${POLYSEED_VERSION}" salvium/external/polyseed
	mv "/utf8proc-${UTF8PROC_VERSION}" salvium/external/utf8proc
	# Salvium exports HAVE_EXPLICIT_BZERO globally, but musl's strict C11
	# headers do not expose bzero. Use bc-ur's volatile zeroing fallback.
	sed -i \
		's/#elif defined(HAVE_EXPLICIT_BZERO)/#elif defined(HAVE_EXPLICIT_BZERO) \&\& !defined(__linux__)/' \
		salvium/external/bc-ur/src/memzero.c
	# easylogging++ assumes glibc's execinfo API on every Linux target. StageX
	# uses musl, so disable its optional stacktrace path for this native library.
	sed -i \
		'/#  if (ELPP_COMPILER_GCC/ s/ELPP_COMPILER_GCC/ELPP_COMPILER_GCC \&\& !defined(__linux__)/' \
		salvium/external/easylogging++/easylogging++.h
	# Current Boost rejects enum minus-one probes under current Clang. C++17's
	# standard trait supports both integral and enumeration types directly.
	sed -i \
		-e 's|#include <boost/type_traits/make_unsigned.hpp>|#include <type_traits>|' \
		-e 's/boost::make_unsigned/std::make_unsigned/g' \
		salvium/src/serialization/binary_archive.h
	sed -i 's/if (STATIC)/if (TRUE)/' salvium/external/polyseed/CMakeLists.txt
	git apply --whitespace=nowarn /tmp/fix-av.patch

	cmake -S salvium_libwallet2_api_c -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DHOST_ABI="${ARCH}-linux-gnu" \
		-DARCH=default \
		-DMONERO_FLAVOR=salvium \
		-DMANUAL_SUBMODULES=ON \
		-DUSE_DEVICE_TREZOR=OFF \
		-DBUILD_GUI_DEPS=ON \
		-DBUILD_TESTS=OFF \
		-DBUILD_DOCUMENTATION=OFF \
		-DReadline_ROOT_DIR=/usr
	cmake --build build
	install -Dm755 build/libwallet2_api_c.so \
		/rootfs/usr/lib/libsalvium_libwallet2_api_c.so
	install -Dm644 salvium_libwallet2_api_c/src/main/cpp/wallet2_api_c.h \
		/rootfs/usr/include/wallet2_api_c.h
	install -Dm644 LICENSE \
		/rootfs/usr/share/licenses/stack-wallet-cs-salvium/LICENSE
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
